#!/bin/sh
# The one command an agent runs before opening a pull request.
#
# It costs no tokens on purpose: everything here is a command with an exit code,
# so an agent reports what it printed instead of reasoning about whether the work
# is sound. A red check means no pull request.
#
#   tools/pre-pr-check                 # compare against dev
#   tools/pre-pr-check --base <ref>    # compare against the phase branch, usually
#
# Every check below exists because this repository already paid for it once. The
# reason is written above each one; do not add a check without one.

set -u

BASE="dev"
while [ $# -gt 0 ]; do
  case "$1" in
    --base) BASE="${2:-}"; shift 2 ;;
    -h|--help) sed -n '2,12p' "$0"; exit 0 ;;
    *) echo "unknown argument: $1" >&2; exit 2 ;;
  esac
done

cd "$(git rev-parse --show-toplevel)" || exit 2

FAILURES=0
report() { printf '%s %s\n' "$1" "$2"; }
fail() { FAILURES=$((FAILURES + 1)); report "FAIL" "$1"; }
pass() { report "pass" "$1"; }
detail() { printf '       %s\n' "$1"; }

BRANCH="$(git rev-parse --abbrev-ref HEAD)"
if ! git rev-parse --verify --quiet "$BASE" >/dev/null; then
  if git rev-parse --verify --quiet "origin/$BASE" >/dev/null; then
    BASE="origin/$BASE"
  else
    echo "base ref '$BASE' does not exist. Pass --base <ref>." >&2
    exit 2
  fi
fi
MERGE_BASE="$(git merge-base HEAD "$BASE")"

echo "pre-pr-check: branch '$BRANCH' against '$BASE'"
echo

# 1. main and dev are not worked on directly. main only ever receives a pull
#    request from dev, and that merge belongs to the project owner.
case "$BRANCH" in
  main|dev) fail "the work is on '$BRANCH' itself. Branch first; main and dev are never worked on directly." ;;
  phase/*) pass "branch name: phase branch, so it opens its pull request against dev" ;;
  */*) pass "branch name: $BRANCH" ;;
  *) fail "branch '$BRANCH' is not 'type/description'" ;;
esac

COMMITS="$(git rev-list "$MERGE_BASE..HEAD" | wc -l | tr -d ' ')"
if [ "$COMMITS" -eq 0 ]; then
  fail "no commits on top of $BASE — there is nothing to open a pull request for"
else
  pass "$COMMITS commit(s) on top of $BASE"
fi

# 2. Commit hygiene. CLAUDE.md fixes the format; a hook does not enforce it here.
TYPES='feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert'
BAD_SUBJECTS=0
for SHA in $(git rev-list "$MERGE_BASE..HEAD"); do
  SUBJECT="$(git log -1 --format=%s "$SHA")"
  case "$SUBJECT" in
    "Merge "*) continue ;;
  esac
  if ! printf '%s' "$SUBJECT" | grep -Eq "^($TYPES)(\([a-z0-9._-]+\))?: .+"; then
    BAD_SUBJECTS=$((BAD_SUBJECTS + 1)); detail "not a conventional subject: $SHA $SUBJECT"
  elif [ "${#SUBJECT}" -gt 71 ]; then
    BAD_SUBJECTS=$((BAD_SUBJECTS + 1)); detail "subject is not under 72 characters: $SHA $SUBJECT"
  fi
done
[ "$BAD_SUBJECTS" -eq 0 ] && pass "commit subjects" || fail "$BAD_SUBJECTS commit subject(s) break the convention"

if git log "$MERGE_BASE..HEAD" --format=%B | grep -qi '^Co-Authored-By:'; then
  fail "a commit carries a Co-Authored-By trailer, which this repository does not use"
else
  pass "no Co-Authored-By trailers"
fi

CHANGED="$(git diff --name-only "$MERGE_BASE..HEAD")"
DIRTY="$(git status --porcelain)"
if [ -n "$DIRTY" ]; then
  fail "the working tree is not clean — commit or drop these before the pull request"
  printf '%s\n' "$DIRTY" | sed 's/^/       /'
else
  pass "working tree clean"
fi

# 3. The memory-path trap. .claude/agent-memory/ is tracked, so an agent standing
#    in a linked worktree writes its memory into that checkout instead of the
#    canonical one. Corrected by hand three times during phase 09 alone.
GIT_DIR_PATH="$(git rev-parse --absolute-git-dir)"
COMMON_DIR_PATH="$(cd "$(git rev-parse --git-common-dir)" && pwd)"
MEMORY_TOUCHED="$(printf '%s\n' "$CHANGED" | grep '^\.claude/agent-memory/' || true)"
if [ -n "$MEMORY_TOUCHED" ] && [ "$GIT_DIR_PATH" != "$COMMON_DIR_PATH" ]; then
  fail "agent memory was written from a linked worktree, so it landed in the wrong checkout"
  detail "canonical directory: $(dirname "$COMMON_DIR_PATH")/.claude/agent-memory/"
  printf '%s\n' "$MEMORY_TOUCHED" | sed 's/^/       /'
elif [ -n "$MEMORY_TOUCHED" ]; then
  pass "agent memory written in the main checkout"
fi

# 4. Build output and local artifacts. A TeaVM dist or a build/ directory is
#    megabytes of generated noise and has been committed by accident before.
ARTIFACTS="$(printf '%s\n' "$CHANGED" | grep -E '(^|/)(build|\.gradle|bin|out)/|\.class$|\.log$' || true)"
if [ -n "$ARTIFACTS" ]; then
  fail "build output or a local artifact is in the diff"
  printf '%s\n' "$ARTIFACTS" | sed 's/^/       /'
else
  pass "no build output in the diff"
fi

# 5. Markdown links. docs/ links documents to each other constantly and a moved
#    file breaks them silently. Code references — a class or a path named in
#    backticks — are the job of docs-refs (issue #56), not of this check.
BROKEN_LINKS=0
MD_FILES="$(printf '%s\n' "$CHANGED" | grep '\.md$' || true)"
for MD in $MD_FILES; do
  [ -f "$MD" ] || continue
  DIR="$(dirname "$MD")"
  grep -o ']([^)#][^)]*)' "$MD" 2>/dev/null | sed 's/^](//; s/)$//' | while read -r LINK; do
    case "$LINK" in
      http*|mailto:*|'#'*) continue ;;
    esac
    TARGET="${LINK%%#*}"
    [ -z "$TARGET" ] && continue
    if [ ! -e "$DIR/$TARGET" ] && [ ! -e "$TARGET" ]; then
      echo "broken:$MD -> $LINK"
    fi
  done > /tmp/pre-pr-links.$$ 2>/dev/null
  if [ -s /tmp/pre-pr-links.$$ ]; then
    BROKEN_LINKS=$((BROKEN_LINKS + 1))
    sed 's/^broken:/       /' /tmp/pre-pr-links.$$
  fi
  rm -f /tmp/pre-pr-links.$$
done
[ "$BROKEN_LINKS" -eq 0 ] && pass "markdown links resolve" || fail "$BROKEN_LINKS changed document(s) link to something that is not there"

# 6. The executable bit. Git on Windows does not record it, so a script committed
#    from this machine arrives at a Linux runner as mode 100644 and dies with
#    "Permission denied". That is exactly how phase 09's first two CI runs failed.
NOT_EXECUTABLE=0
for SCRIPT in $(printf '%s\n' "$CHANGED" | grep -E '^(tools/|gradlew$)' || true); do
  [ -f "$SCRIPT" ] || continue
  case "$SCRIPT" in
    *.md|*.json|*.txt) continue ;;
  esac
  MODE="$(git ls-files -s -- "$SCRIPT" | awk '{print $1}')"
  if [ "$MODE" = "100644" ]; then
    NOT_EXECUTABLE=$((NOT_EXECUTABLE + 1))
    detail "$SCRIPT is mode 100644 — run: git update-index --chmod=+x $SCRIPT"
  fi
done
[ "$NOT_EXECUTABLE" -eq 0 ] && pass "scripts carry the executable bit" || fail "$NOT_EXECUTABLE script(s) would arrive at a Linux runner without the executable bit"

# 7. The build, but only when the change can break it. A documentation phase that
#    waits four minutes for Gradle learns nothing and stops running the check.
CODE_TOUCHED="$(printf '%s\n' "$CHANGED" | grep -E '^(core|game|desktop|web|assets)/|\.gradle(\.kts)?$|^gradle/|^gradlew' || true)"
if [ -n "$CODE_TOUCHED" ]; then
  echo
  echo "code changed — running ./gradlew build"
  if ./gradlew build --console=plain -q; then
    pass "./gradlew build"
  else
    fail "./gradlew build"
  fi
else
  pass "no code in the diff, so the build was not run"
fi

echo
if [ "$FAILURES" -eq 0 ]; then
  echo "pre-pr-check: PASS — $COMMITS commit(s), $(printf '%s\n' "$CHANGED" | grep -c . ) file(s) changed"
  exit 0
fi
echo "pre-pr-check: FAIL — $FAILURES check(s) failed. Fix them; do not open the pull request."
exit 1
