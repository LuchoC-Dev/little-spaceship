#!/bin/sh
# Refuses a commit whose subject breaks the Conventional Commits convention.
#
# `tools/pre-pr-check` already checks this, but only over a sub-branch's own
# commits. Agent memory never appears there: the pre-commit hook next to this one
# forces `.claude/agent-memory/` to be committed from the main checkout, which
# sits on the phase branch, so those commits are in no sub-branch's diff. Nothing
# looked at them until the phase-level check, once, at the end.
#
# Phase 11b paid for that. Three agents wrote three different malformed scopes —
# `docs(core-domain memory):`, `docs(level-designer memory):` — and by the time
# anything noticed they were 55 commits deep in a branch about to open against
# `dev`. Fixing three subjects cost a history rewrite, an explicit exception from
# the project owner to a rule that forbids force-pushing, and corrections to three
# closed issues whose cited merge hashes the rewrite destroyed.
#
# A subject is cheap to fix at the moment it is written and expensive afterwards,
# which is exactly the shape a hook is for.
#
# This runs on every commit, not only on memory: a rule with one exception is a
# rule someone has to remember the boundary of.
#
# Install: tools/install-hooks

set -u

MSG_FILE="$1"
SUBJECT="$(sed -n '1p' "$MSG_FILE")"

# Merges are git's own wording, and a comment-only file means the commit is being
# aborted anyway.
case "$SUBJECT" in
  "Merge "*|"Revert \""*|"fixup!"*|"squash!"*|"#"*|"") exit 0 ;;
esac

TYPES='feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert'

if ! printf '%s' "$SUBJECT" | grep -Eq "^($TYPES)(\([a-z0-9._-]+\))?: .+"; then
  echo "commit-msg: this subject does not follow Conventional Commits" >&2
  echo "  $SUBJECT" >&2
  echo >&2
  echo "  type(scope): description — scope optional, lowercase, only a-z 0-9 . _ -" >&2
  echo "  types: feat fix docs style refactor perf test build ci chore revert" >&2
  echo >&2
  echo "  a scope with a space in it is the one that keeps happening:" >&2
  echo "    docs(core-domain memory): …   is rejected" >&2
  echo "    docs(memory): …               is the form for agent memory" >&2
  exit 1
fi

if [ "${#SUBJECT}" -gt 71 ]; then
  echo "commit-msg: subject is ${#SUBJECT} characters; the limit is 71" >&2
  echo "  $SUBJECT" >&2
  exit 1
fi

exit 0
